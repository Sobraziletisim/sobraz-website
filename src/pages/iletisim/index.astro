---
import Base from '../../layouts/Base.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import { site, hizmetler } from '../../data/site';
---
<Base title="İletişim" description="Sobraz ile iletişime geçin: Quick Tower, Workinton, Ataşehir / İstanbul. Telefon: 0216 532 12 51.">
  <SayfaBasi
    ust={[{ ad: 'İletişim', url: '/iletisim/' }]}
    baslik="Hikayenizi konuşalım."
    giris="Yeni bir proje, bir iş birliği fikri ya da yalnızca bir soru. Formu doldurun, size en kısa sürede dönelim."
  />

  <div class="iletisim">
    <section class="form-alani" id="form" aria-labelledby="form-baslik">
      <h2 id="form-baslik" class="gorunmez">İletişim formu</h2>
      <form method="post" action="/api/iletisim">
        <div class="alan-grup">
          <div class="alan">
            <label for="ad">Adınız soyadınız</label>
            <input id="ad" name="ad" type="text" autocomplete="name" required maxlength="100" />
          </div>
          <div class="alan">
            <label for="sirket">Şirketiniz</label>
            <input id="sirket" name="sirket" type="text" autocomplete="organization" maxlength="120" />
          </div>
        </div>
        <div class="alan-grup">
          <div class="alan">
            <label for="eposta">E-posta adresiniz</label>
            <input id="eposta" name="eposta" type="email" autocomplete="email" required maxlength="160" />
          </div>
          <div class="alan">
            <label for="telefon">Telefonunuz <span>(isteğe bağlı)</span></label>
            <input id="telefon" name="telefon" type="tel" autocomplete="tel" maxlength="30" />
          </div>
        </div>
        <div class="alan">
          <label for="konu">Hangi konuda yazıyorsunuz?</label>
          <select id="konu" name="konu">
            <option value="Yeni proje">Yeni bir proje</option>
            {hizmetler.map((h) => <option value={h.ad}>{h.ad}</option>)}
            <option value="Basın">Basın</option>
            <option value="Kariyer">Kariyer</option>
            <option value="Diğer">Diğer</option>
          </select>
        </div>
        <div class="alan">
          <label for="mesaj">Mesajınız</label>
          <textarea id="mesaj" name="mesaj" rows="6" required maxlength="4000"></textarea>
        </div>

        <div class="tuzak" aria-hidden="true">
          <label for="web">Web siteniz</label>
          <input id="web" name="web" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="onay">
          <input id="kvkk" name="kvkk" type="checkbox" value="evet" required />
          <label for="kvkk">
            <a href="/kvkk/" target="_blank" rel="noopener">KVKK aydınlatma metnini</a> okudum,
            bilgilerimin bu talebe yanıt verilmesi amacıyla işlenmesini kabul ediyorum.
          </label>
        </div>

        <button class="dugme" type="submit">Mesajı gönder</button>
      </form>
    </section>

    <aside class="bilgi">
      <div>
        <h2>Telefon</h2>
        <a class="buyuk-baglanti" href={site.telefonHref}>{site.telefon}</a>
      </div>
      <div>
        <h2>E-posta</h2>
        <a class="buyuk-baglanti" href={`mailto:${site.eposta}`}>{site.eposta}</a>
      </div>
      <div>
        <h2>Ofis</h2>
        <address>
          {site.adres.satir1}<br />
          {site.adres.satir2}<br />
          {site.adres.ilce} / {site.adres.il}
        </address>
        <a class="metin-baglanti" href={site.haritaUrl} target="_blank" rel="noopener">Haritada aç</a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .iletisim {
    display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 3rem clamp(2rem, 6vw, 6rem);
    padding: clamp(3rem, 7vw, 6rem) var(--kenar) clamp(4rem, 9vw, 8rem);
  }
  form { display: grid; gap: 1.5rem; }
  .alan-grup { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .alan { display: grid; gap: 0.5rem; }
  label { font-family: var(--display); font-size: 1rem; font-weight: 500; }
  label span { color: var(--gri); font-weight: 400; }
  input[type='text'], input[type='email'], input[type='tel'], select, textarea {
    font: inherit; font-size: 1.125rem; color: var(--murekkep);
    background: #fff; border: 1.5px solid var(--murekkep); border-radius: 0.75rem;
    padding: 0.8rem 1rem; width: 100%;
  }
  textarea { resize: vertical; min-height: 9rem; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--sari); outline-offset: 0; border-color: var(--murekkep); }
  .tuzak { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .onay { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; align-items: start; }
  .onay input { width: 1.35rem; height: 1.35rem; margin: 0.2rem 0 0; accent-color: var(--murekkep); }
  .onay label { font-family: var(--metin); font-weight: 400; font-size: 1.0625rem; line-height: 1.5; }
  button.dugme { justify-self: start; font-size: 1.125rem; padding: 1rem 2rem; }

  .bilgi { display: grid; gap: 2.5rem; align-content: start; border-top: 2px solid var(--murekkep); padding-top: 1.75rem; }
  .bilgi h2 { font-family: var(--display); font-size: 1rem; font-weight: 600; color: var(--gri); margin: 0 0 0.5rem; }
  .buyuk-baglanti { font-family: var(--display); font-size: clamp(1.375rem, 1rem + 1.2vw, 2rem); font-weight: 550; letter-spacing: -0.02em; text-decoration: none; overflow-wrap: anywhere; }
  .buyuk-baglanti:hover { text-decoration: underline; text-decoration-color: var(--sari); text-decoration-thickness: 3px; }
  address { font-style: normal; margin-bottom: 0.75rem; }

  @media (max-width: 56rem) {
    .iletisim { grid-template-columns: 1fr; }
  }
  @media (max-width: 36rem) {
    .alan-grup { grid-template-columns: 1fr; }
  }
</style>
