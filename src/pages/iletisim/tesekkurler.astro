---
import Base from '../../layouts/Base.astro';
import Halka from '../../components/Halka.astro';
---
<Base title="Mesajınız alındı" noindex>
  <section class="sonuc">
    <div>
      <h1>Mesajınız bize ulaştı.</h1>
      <p>Teşekkürler. Ekibimiz mesajınızı okuyup en kısa sürede size dönecek.</p>
      <a class="dugme" href="/">Ana sayfaya dön</a>
    </div>
    <div class="sonuc-halka"><Halka boyut="kucuk" /></div>
  </section>
</Base>

<style>
  .sonuc {
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem; align-items: center;
    padding: clamp(4rem, 10vw, 8rem) var(--kenar);
    min-height: 60vh;
  }
  h1 { font-family: var(--display); font-size: clamp(2.5rem, 1.4rem + 4vw, 5rem); font-weight: 650; line-height: 1; letter-spacing: -0.045em; margin: 0 0 1.25rem; }
  p { margin: 0 0 2rem; max-width: 30rem; }
  .sonuc-halka { max-width: 20rem; width: 100%; justify-self: center; }
  @media (max-width: 48rem) { .sonuc { grid-template-columns: 1fr; } .sonuc-halka { max-width: 12rem; justify-self: start; order: -1; } }
</style>
