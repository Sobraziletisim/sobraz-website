---
import type { CollectionEntry } from 'astro:content';
import { hizmetler } from '../data/site';
interface Props { is: CollectionEntry<'isler'>; buyuk?: boolean }
const { is, buyuk = false } = Astro.props;
const d = is.data;
const kimlik = d.marka ?? d.sektor ?? 'Sobraz';
const etiketler = d.hizmetler.map((s) => hizmetler.find((h) => h.slug === s)?.ad).filter(Boolean);
---
<article class:list={['is-karti', { buyuk }]}>
  <a href={`/isler/${is.id}/`}>
    <div class="kapak">
      {d.kapak
        ? <img src={d.kapak} alt="" loading="lazy" decoding="async" />
        : <span class="kapak-marka" aria-hidden="true">{kimlik}</span>}
    </div>
    <p class="marka">{kimlik}, {d.yil}</p>
    <h3>{d.baslik}</h3>
    {etiketler.length > 0 && <p class="etiket">{etiketler.join(', ')}</p>}
  </a>
</article>

<style>
  .is-karti a { display: block; text-decoration: none; }
  .kapak {
    aspect-ratio: 4 / 3; border-radius: 1.25rem; overflow: hidden;
    background: var(--murekkep); display: grid; place-items: center;
    margin-bottom: 1.1rem;
  }
  .buyuk .kapak { aspect-ratio: 16 / 9; }
  .kapak img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
  .kapak-marka { font-family: var(--display); color: var(--sari); font-size: clamp(1.75rem, 1rem + 2.5vw, 3rem); font-weight: 650; letter-spacing: -0.04em; padding: 1rem; text-align: center; }
  .is-karti a:hover img { transform: scale(1.03); }
  .marka { font-family: var(--display); font-size: 0.975rem; color: var(--gri); margin: 0 0 0.35rem; }
  h3 { font-family: var(--display); font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.12; margin: 0; }
  .is-karti a:hover h3 { text-decoration: underline; text-decoration-color: var(--sari); text-decoration-thickness: 3px; }
  .etiket { font-size: 1rem; color: var(--gri); margin: 0.5rem 0 0; }
</style>
