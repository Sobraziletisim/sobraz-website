---
import { site } from '../data/site';
import Logo from './Logo.astro';
interface Props { boyut?: 'buyuk' | 'kucuk'; merkez?: string }
const { boyut = 'buyuk', merkez = 'sobraz' } = Astro.props;
const id = `yorunge-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class:list={['halka', boyut]} viewBox="0 0 500 500" aria-hidden="true" focusable="false">
  <defs>
    <path id={id} d="M250,250 m-205,0 a205,205 0 1,1 410,0 a205,205 0 1,1 -410,0" />
  </defs>
  <g class="donen">
    <text>
      <textPath href={`#${id}`} textLength="1286" lengthAdjust="spacing">{site.slogan} ✳ {site.slogan} ✳</textPath>
    </text>
  </g>
  <circle class="dunya" cx="250" cy="250" r="150" />
  {merkez === 'sobraz' ? <Logo class="merkez-logo" x="132" y="229" width="236" height="41" /> : <text class="merkez" x="250" y="262" text-anchor="middle">{merkez}</text>}
</svg>

<style>
  .halka { width: 100%; overflow: visible; }
  .halka text {
    font-family: var(--display);
    font-size: 31px; font-weight: 600; letter-spacing: -0.01em;
    fill: currentColor;
  }
  .donen { transform-origin: 250px 250px; animation: don 48s linear infinite; }
  .kucuk .donen { animation-duration: 36s; }
  @keyframes don { to { transform: rotate(-360deg); } }
  .dunya { fill: var(--halka-dunya, var(--sari)); }
  .merkez-logo { color: var(--halka-logo, var(--murekkep)); }
  .halka .merkez { font-size: 64px; font-weight: 750; letter-spacing: -0.04em; fill: var(--halka-logo, var(--murekkep)); }
</style>
